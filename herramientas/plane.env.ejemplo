# Copiar como herramientas/plane.env (no se sube al repositorio) y completar.
# Token: Plane > Profile settings > Personal access tokens
PLANE_API_KEY=plane_api_xxxxxxxxxxxxxxxx
# Slug del workspace: lo que sigue a plane.atwire.net/ en la URL
PLANE_WORKSPACE=mi-workspace
# Proyecto por defecto: identificador (p. ej. QE), nombre o UUID
PLANE_PROJECT=QE
# PLANE_URL=https://plane.atwire.net
