@startuml secuencia-cu-005-001
!include _estilo.iuml
title CU-005-001 Gestionar gasto recurrente (alta)

actor Usuario
participant "Frontend\n(vía proxy de API)" as FE
participant "RecurringExpense\nController" as CTRL
participant "RecurringExpense\nService" as RES
participant "RecurringExpense\nMaterializer" as MAT
database "PostgreSQL" as DB

Usuario -> FE : completa monto, cuenta, frecuencia y fecha de inicio
FE -> CTRL : POST /recurring-expenses
CTRL -> RES : create(solicitud)
activate RES
alt con carga retroactiva
  RES -> RES : materializar desde la fecha de inicio
else sin carga retroactiva
  RES -> MAT : today(espacio)
  MAT --> RES : fecha actual en la zona horaria del espacio
end
RES -> DB : guardar gasto recurrente
RES -> MAT : reconcile(gasto, desde)
group reconcile («include» CU-005-003)
  MAT -> MAT : calcular fechas hasta hoy + días de anticipación
  MAT -> DB : borrar ocurrencias PENDING que el cronograma ya no genera
  MAT -> DB : crear las ocurrencias PENDING faltantes
  MAT -> DB : actualizar materializedUntil
end
RES --> CTRL : gasto recurrente
deactivate RES
CTRL --> FE : 200
FE --> Usuario : muestra el gasto y sus próximas ocurrencias
@enduml
