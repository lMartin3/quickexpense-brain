@startuml
!pragma layout smetana
!include _estilo.iuml
hide empty methods
skinparam classAttributeIconSize 0

package "expense.domain.entity" as pent {
  interface WorkspaceOwned {
    +workspaceId: WorkspaceId
  }

  class Workspace {
    +id: WorkspaceId
    +name: Name
    +description: Description?
    +color: HexColor
    +owner: UserId
    +members: Map<UserId, WorkspaceRole>
    +timeZone: ZoneId
  }

  enum WorkspaceRole {
    READ_ONLY
    MEMBER
    ADMIN
  }

  class User {
    +id: UserId
    +email: Email?
    +emailVerified: Boolean
    +displayName: Name?
    +createdAt: Instant
    +lastSeenAt: Instant
  }

  class UserSettings {
    +userId: UserId
    +telegramId: String?
    +defaultChatbotWorkspaceId: WorkspaceId?
    +uiLanguage: LanguageCode?
  }

  class Account {
    +id: AccountId
    +name: Name
    +description: Description?
    +currency: CurrencyCode
    +accountType: AccountType
    +accountFlag: AccountFlag?
    +categoryId: AccountCategoryId?
    +workspaceId: WorkspaceId
  }

  enum AccountType {
    ASSET
    LIABILITY
    INCOME
    EXPENSE
    EQUITY
    +allowsInitialBalance: Boolean
  }

  enum AccountFlag {
    INITIAL_BALANCE_SOURCE
    +accountType: AccountType
  }

  class AccountCategory {
    +id: AccountCategoryId
    +workspaceId: WorkspaceId
    +name: Name
    +description: Description?
    +hexColor: HexColor?
  }

  class JournalEntry {
    +journalEntryId: JournalEntryId
    +date: Instant
    +description: Description
    +creationDate: Instant
    +modificationDate: Instant
    +categoryId: JournalCategoryId?
    +workspaceId: WorkspaceId
  }

  class Posting {
    +id: PostingId
    +workspaceId: WorkspaceId
    +accountId: AccountId
    +amount: BigDecimal
    +isDebit: Boolean
  }

  class JournalCategory {
    +id: JournalCategoryId
    +workspaceId: WorkspaceId
    +name: Name
    +description: Description?
    +hexColor: HexColor?
  }

}


Workspace .up.|> WorkspaceOwned
Account .up.|> WorkspaceOwned
AccountCategory .up.|> WorkspaceOwned
JournalEntry .up.|> WorkspaceOwned
Posting .up.|> WorkspaceOwned
JournalCategory .up.|> WorkspaceOwned

Workspace "*" -- "1" User : owner
Workspace "*" -- "*" User : members
Workspace -- WorkspaceRole
User "1" -- "0..1" UserSettings
UserSettings "*" -- "0..1" Workspace : defaultChatbotWorkspaceId

Workspace "1" *-- "*" Account
Workspace "1" *-- "*" AccountCategory
Workspace "1" *-- "*" JournalCategory
Workspace "1" *-- "*" JournalEntry

Account "*" -- "0..1" AccountCategory
Account -- AccountType
Account -- AccountFlag
JournalEntry "1" *-- "2..*" Posting : postings
Posting "*" -- "1" Account
JournalEntry "*" -- "0..1" JournalCategory

@enduml

