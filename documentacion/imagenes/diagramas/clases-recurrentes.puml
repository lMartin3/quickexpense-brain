@startuml
!pragma layout smetana
!include _estilo.iuml
hide empty methods
skinparam classAttributeIconSize 0

package "expense.domain.entity" as pent {
  class RecurringExpense {
    +id: RecurringExpenseId
    +workspaceId: WorkspaceId
    +name: Name
    +description: Description?
    +sourceAccountId: AccountId
    +destinationAccountId: AccountId
    +amount: BigDecimal
    +currency: CurrencyCode
    +recurrenceRule: RecurrenceRule
    +recurrenceEnd: RecurrenceEnd
    +startDate: LocalDate
    +costType: CostType
    +active: Boolean
    +journalCategoryId: JournalCategoryId?
    +estimationStrategy: EstimationStrategy?
    +leadDays: Int
    +materializeFrom: LocalDate
    +materializedUntil: LocalDate?
    +schedule: RecurrenceSchedule
  }

  class RecurringExpenseInstance {
    +id: RecurringExpenseInstanceId
    +workspaceId: WorkspaceId
    +recurringExpenseId: RecurringExpenseId
    +estimatedDate: LocalDate
    +status: RecurringExpenseInstanceStatus
    +realAmount: BigDecimal?
    +journalEntryId: JournalEntryId?
    +realDate: LocalDate?
  }

  enum RecurringExpenseInstanceStatus {
    PENDING
    CONFIRMED
    SKIPPED
  }

  enum CostType {
    FIXED
    VARIABLE
  }

  interface EstimationStrategy <<sealed>>
  class MatchPercentage {
    +percentage: BigDecimal
  }

  class Account
  class JournalCategory
  class JournalEntry
  class Workspace
}

package "expense.domain.recurrence" as prec {
  class RecurrenceSchedule
  interface RecurrenceRule <<sealed>>
  interface RecurrenceEnd <<sealed>>
}

Workspace "1" *-- "*" RecurringExpense
RecurringExpense "1" *-- "*" RecurringExpenseInstance : instancias
RecurringExpense "*" -- "1" Account : sourceAccountId
RecurringExpense "*" -- "1" Account : destinationAccountId
RecurringExpense "*" -- "0..1" JournalCategory
RecurringExpense *-- "1" RecurrenceRule
RecurringExpense *-- "1" RecurrenceEnd
RecurringExpense *-- "0..1" EstimationStrategy
RecurringExpense -- CostType
RecurringExpense ..> RecurrenceSchedule : schedule
RecurringExpenseInstance -- RecurringExpenseInstanceStatus
RecurringExpenseInstance "*" -- "0..1" JournalEntry : movimiento
@enduml
